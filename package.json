{
  "name": "kotsutsmi-design-system",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --cache-dir=.turbo",
    "build": "turbo run build --cache-dir=.turbo",
    "lint": "turbo run lint --cache-dir=.turbo",
    "lint-fix": "turbo run lint-fix --cache-dir=.turbo",
    "format": "turbo run format --cache-dir=.turbo",
    "build-storybook": "turbo run build-storybook --cache-dir=.turbo",
    "storybook": "pnpm --filter @kotsutsmi/ui storybook",
    "tokens": "pnpm --filter @kotsutsmi/tokens",
    "ui": "pnpm --filter @kotsutsmi/ui",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.1",
    "@commitlint/config-conventional": "21.2.0",
    "lefthook": "2.1.10",
    "oxfmt": "0.60.0",
    "oxlint": "1.71.0",
    "turbo": "2.10.6",
    "typescript": "5.9.3"
  },
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  }
}
